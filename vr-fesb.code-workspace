{
  // Opens the app and the localization server in one VS Code window.
  // One key: Ctrl+Shift+B starts the server and then builds, installs and starts the app on the phone (USB);
  // the same from Run and Debug (F5). Terminal -> Run Task... lists every task below.
  "folders": [
    { "name": "app", "path": "app" },
    { "name": "localization-server", "path": "localization-server" },
    { "name": "docs", "path": "docs" }
  ],
  "settings": {
    "files.exclude": {
      "**/node_modules": true,
      "**/android/app/build": true,
      "**/.gradle": true,
      "**/__pycache__": true,
      "**/.pytest_cache": true,
      "**/.test-build": true
    },
    "search.exclude": {
      "**/android": true,
      "**/.venv": true,
      "**/data": true
    },
    "terminal.integrated.defaultProfile.windows": "PowerShell"
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "msjsdiag.vscode-react-native"
    ]
  },
  // Run and Debug (F5): these only start the tasks below - the app runs on the phone, the server in a terminal.
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Demo: server, then the app on the phone",
        "type": "node",
        "request": "launch",
        "preLaunchTask": "Demo: server, then the app on the phone",
        "cwd": "${workspaceFolder:app}",
        "runtimeArgs": ["-e", "console.log('The server runs (its terminal and its panel), the app is started on the phone.')"],
        "console": "internalConsole",
        "rootPath": "${workspaceFolder:app}",
        "sourceMaps": false,
        "outFiles": [],
        "resolveSourceMapLocations": []
      },
      {
        "name": "App: build, install and start on the phone",
        "type": "node",
        "request": "launch",
        "preLaunchTask": "App: build, install and start",
        "cwd": "${workspaceFolder:app}",
        "runtimeArgs": ["-e", "console.log('The app is installed and started on the phone.')"],
        "console": "internalConsole",
        "rootPath": "${workspaceFolder:app}",
        "sourceMaps": false,
        "outFiles": [],
        "resolveSourceMapLocations": []
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "App: type check",
        "type": "shell",
        "command": "npm run typecheck",
        "options": { "cwd": "${workspaceFolder:app}" },
        "problemMatcher": "$tsc"
      },
      {
        "label": "App: unit tests",
        "type": "shell",
        "command": "npm test",
        "options": { "cwd": "${workspaceFolder:app}" },
        "group": "test",
        "problemMatcher": []
      },
      {
        "label": "App: generate the Android project (expo prebuild)",
        "type": "shell",
        "command": "npm run prebuild",
        "options": { "cwd": "${workspaceFolder:app}" },
        "problemMatcher": []
      },
      {
        "label": "App: build the debug APK",
        "type": "shell",
        "command": ".\\gradlew.bat assembleDebug --console=plain",
        "options": { "cwd": "${workspaceFolder:app}/android" },
        "group": "build",
        "problemMatcher": []
      },
      {
        "label": "App: install on the phone and start",
        "type": "shell",
        "command": "& \"$env:ANDROID_HOME\\platform-tools\\adb.exe\" install -r android\\app\\build\\outputs\\apk\\debug\\app-debug.apk; & \"$env:ANDROID_HOME\\platform-tools\\adb.exe\" shell monkey -p hr.fesb.arportal -c android.intent.category.LAUNCHER 1",
        "options": { "cwd": "${workspaceFolder:app}" },
        "problemMatcher": []
      },
      {
        "label": "App: build, install and start",
        "type": "shell",
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\run-on-phone.ps1",
        "options": { "cwd": "${workspaceFolder:app}" },
        "group": "build",
        "problemMatcher": []
      },
      {
        "label": "App: Metro (development loop, phone on USB)",
        "type": "shell",
        "command": "& \"$env:ANDROID_HOME\\platform-tools\\adb.exe\" reverse tcp:8081 tcp:8081; npx expo start",
        "options": { "cwd": "${workspaceFolder:app}" },
        "isBackground": true,
        "problemMatcher": []
      },
      {
        "label": "App: phone log (logcat)",
        "type": "shell",
        "command": "& \"$env:ANDROID_HOME\\platform-tools\\adb.exe\" logcat -s ReactNativeJS:V AndroidRuntime:E",
        "isBackground": true,
        "problemMatcher": []
      },
      {
        "label": "Server: start (with the panel)",
        "type": "shell",
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\start-server.ps1",
        "options": { "cwd": "${workspaceFolder:localization-server}" },
        "isBackground": true,
        // the server keeps running; this only tells VS Code when it is ready, so that a task waiting for it goes on
        "problemMatcher": {
          "owner": "arportal-server",
          "pattern": { "regexp": "^__never_matches__$" },
          "background": {
            "activeBegins": true,
            "beginsPattern": "STARTING",
            "endsPattern": "SERVER IS RUNNING|COULD NOT START"
          }
        }
      },
      {
        "label": "Demo: server, then the app on the phone",
        "dependsOrder": "sequence",
        "dependsOn": ["Server: start (with the panel)", "App: build, install and start"],
        "group": { "kind": "build", "isDefault": true },
        "problemMatcher": []
      },
      {
        "label": "Server: tests",
        "type": "shell",
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -Command \". .\\env.ps1; uv run pytest\"",
        "options": { "cwd": "${workspaceFolder:localization-server}" },
        "group": "test",
        "problemMatcher": []
      },
      {
        "label": "Server: check why a phone cannot connect (doctor)",
        "type": "shell",
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -Command \". .\\env.ps1; uv run locserver-doctor\"",
        "options": { "cwd": "${workspaceFolder:localization-server}" },
        "problemMatcher": []
      }
    ]
  }
}
