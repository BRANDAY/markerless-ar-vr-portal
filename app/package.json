{
  "name": "fesb-ar-portal",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@reactvision/react-viro": "3.2.2",
    "expo": "58.0.26",
    "expo-build-properties": "58.0.12",
    "expo-file-system": "58.0.14",
    "expo-network": "58.0.5",
    "expo-status-bar": "58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "typescript": "6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "prebuild": "expo prebuild --platform android --no-install",
    "prebuild:clean": "expo prebuild --platform android --clean --no-install",
    "build:android": "cd android && gradlew.bat assembleDebug --console=plain",
    "install:android": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/generate-assets.mjs",
    "test": "tsc -p tsconfig.test.json && node --test \".test-build/**/*.test.js\""
  },
  "private": true
}
